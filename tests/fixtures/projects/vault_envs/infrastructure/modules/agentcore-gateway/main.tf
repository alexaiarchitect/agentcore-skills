# Generated by the agentcore plugin (agentcore-gateway: --upstream mcp --outbound oauth
# --versions 2025-11-25,2026-07-28 --with-identity), checked against the
# hashicorp/aws provider documentation for 6.64.0 on 2026-10-05, then adapted:
#   * a REQUEST interceptor (Lambda, pass_request_headers = true) that forwards
#     the end user's validated token in params._meta (the generator had no
#     interceptor option at the time);
#   * the gateway role may invoke that interceptor;
#   * allowed_scopes stays empty: Alexa users carry vault scopes, the service
#     client carries mcp:service, and the vault enforces scopes per tool.
data "aws_caller_identity" "current" {}

# The role AgentCore assumes. The SourceAccount condition stops another
# account's AgentCore resource from assuming it (confused deputy).
resource "aws_iam_role" "gateway" {
  name = "${var.name}-gateway"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "bedrock-agentcore.amazonaws.com" }
      Action    = "sts:AssumeRole"
      Condition = { StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id } }
    }]
  })
  tags = var.tags
}

resource "aws_iam_role_policy" "gateway" {
  name = "${var.name}-gateway"
  role = aws_iam_role.gateway.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        # Outbound credentials come from AgentCore Identity's token vault.
        # Action names per the gateway service-role permissions page; confirm
        # against IAM's service authorization reference before applying.
        Sid    = "UseOutboundCredential"
        Effect = "Allow"
        Action = [
          "bedrock-agentcore:GetWorkloadAccessToken",
          "bedrock-agentcore:GetResourceOauth2Token",
          "bedrock-agentcore:GetResourceApiKey",
        ]
        Resource = ["*"]
      },
      {
        Sid      = "InvokeInterceptor"
        Effect   = "Allow"
        Action   = ["lambda:InvokeFunction"]
        Resource = [var.interceptor_lambda_arn]
      },
      {
        Sid      = "ReadVaultSecret"
        Effect   = "Allow"
        Action   = ["secretsmanager:GetSecretValue"]
        Resource = [var.credential_secret_arn]
      }
    ]
  })
}

resource "aws_bedrockagentcore_gateway" "this" {
  name     = var.name
  role_arn = aws_iam_role.gateway.arn

  # Inbound: every MCP request must carry a JWT this issuer signed.
  # Cognito access tokens carry `client_id`, which `allowed_clients` checks;
  # `aud` appears only when the app client uses a resource binding.
  authorizer_type = "CUSTOM_JWT"
  authorizer_configuration {
    custom_jwt_authorizer {
      discovery_url   = var.discovery_url
      allowed_clients = var.allowed_clients
      allowed_scopes  = length(var.allowed_scopes) > 0 ? var.allowed_scopes : null
    }
  }

  # The vault re-verifies the forwarded token itself; the interceptor only
  # copies the Authorization header the gateway has already validated.
  interceptor_configuration {
    interception_points = ["REQUEST"]
    interceptor {
      lambda {
        arn = var.interceptor_lambda_arn
      }
    }
    input_configuration {
      pass_request_headers = true
    }
  }

  protocol_type = "MCP"
  protocol_configuration {
    mcp {
      # 2026-07-28 is opt-in. UpdateGateway replaces this list; it never appends.
      supported_versions = var.supported_versions
    }
  }

  tags = var.tags

  depends_on = [aws_iam_role_policy.gateway]
}

# MCP server target: the gateway speaks MCP to your existing server over HTTPS.
# Tools appear to clients as `<target>___<tool>`.
resource "aws_bedrockagentcore_gateway_target" "vault" {
  name               = var.target_name
  gateway_identifier = aws_bedrockagentcore_gateway.this.gateway_id

  credential_provider_configuration {
    oauth {
      provider_arn = var.oauth_provider_arn
      scopes       = var.oauth_scopes
      # Client credentials (two-legged). The provider documents this argument
      # with mixed casing; confirm the accepted value with
      # `terraform providers schema -json` before the first plan.
      grant_type = "CLIENT_CREDENTIALS"
    }
  }

  target_configuration {
    mcp {
      mcp_server {
        endpoint = var.upstream_endpoint
        # DEFAULT indexes tools at create/update (and on SynchronizeGatewayTargets);
        # DYNAMIC lists them live but cannot be combined with semantic search.
        listing_mode = "DEFAULT"
      }
    }
  }
}
