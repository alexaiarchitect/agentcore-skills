# Generated by the agentcore plugin (agentcore-observe tracing_plan.py) and adapted:
# resource names are prefixed with var.name (the generated names were fixed
# strings, which collide with any other gateway in the account and region).

# Vended logs and spans for gateway. TRACES needs CloudWatch Transaction Search
# enabled in the account first (see transaction-search.sh), so the TRACES
# delivery is created only with enable_gateway_traces = true, after that script ran.
resource "aws_cloudwatch_log_group" "gateway" {
  name              = "/aws/vendedlogs/bedrock-agentcore/gateway/${var.name}"
  retention_in_days = var.log_retention_days
  tags              = var.tags
}

resource "aws_cloudwatch_log_delivery_source" "gateway_logs" {
  name         = "${var.name}-gateway-logs"
  log_type     = "APPLICATION_LOGS"
  resource_arn = var.gateway_arn
}

resource "aws_cloudwatch_log_delivery_destination" "gateway_logs" {
  name = "${var.name}-gateway-logs"
  delivery_destination_configuration {
    destination_resource_arn = aws_cloudwatch_log_group.gateway.arn
  }
}

resource "aws_cloudwatch_log_delivery" "gateway_logs" {
  delivery_source_name     = aws_cloudwatch_log_delivery_source.gateway_logs.name
  delivery_destination_arn = aws_cloudwatch_log_delivery_destination.gateway_logs.arn
}

resource "aws_cloudwatch_log_delivery_source" "gateway_traces" {
  count = var.enable_gateway_traces ? 1 : 0
  name         = "${var.name}-gateway-traces"
  log_type     = "TRACES"
  resource_arn = var.gateway_arn
}

resource "aws_cloudwatch_log_delivery_destination" "gateway_traces" {
  count = var.enable_gateway_traces ? 1 : 0
  name                      = "${var.name}-gateway-traces"
  delivery_destination_type = "XRAY"
}

resource "aws_cloudwatch_log_delivery" "gateway_traces" {
  count = var.enable_gateway_traces ? 1 : 0
  delivery_source_name     = aws_cloudwatch_log_delivery_source.gateway_traces[0].name
  delivery_destination_arn = aws_cloudwatch_log_delivery_destination.gateway_traces[0].arn
}
